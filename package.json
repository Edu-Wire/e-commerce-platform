{
  "name": "retail-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/customer",
    "frontend/admin"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:customer": "npm run dev --workspace=frontend/customer",
    "dev:admin": "npm run dev --workspace=frontend/admin",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:customer\" \"npm run dev:admin\"",
    "seed": "npm run seed --workspace=backend",
    "migrate": "npm run migrate --workspace=backend"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.0",
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "nodemailer": "^8.0.7"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.0"
  }
}
